<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 构建：真机验收用的调试入口（不进入 release APK）。
  另外允许通过 `adb reverse` 访问本机网关时使用明文 HTTP；
  Release 构建不包含该配置，生产网关必须使用 HTTPS。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config">
        <receiver
            android:name=".debug.DebugDomainBlockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.causalguard.debug.BLOCK_DOMAIN" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DebugStatusReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.causalguard.debug.STATUS" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DebugRouteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.causalguard.debug.ADD_ROUTE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DebugUdpProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.causalguard.debug.UDP_PROBE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DebugTcpProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.causalguard.debug.TCP_PROBE" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DebugFullTunnelReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.causalguard.debug.FULL_TUNNEL" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".debug.DebugHttpsProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.causalguard.debug.HTTPS_PROBE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
