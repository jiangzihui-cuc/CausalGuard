+ * THIRD_PARTY_NOTICES.md for the modification record and rollback notes.
+ */
+
+package eu.faircode.netguard;
+
+import android.app.Activity;
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.util.Log;
+
+import java.util.Locale;
+
+/**
+ * CausalGuard 域名阻断控制通道（团队新增，A5-1）。
+ *
+ * 处理 CausalGuard 独立 APK 发来的 ordered broadcast（`ACTION_BLOCK_DOMAIN`），
+ * 把目标域名写入运行期阻断集（{@link ServiceSinkhole#mapCausalGuardBlocked}），
+ * 供 {@link ServiceSinkhole#isDomainBlocked(String)} 在 DNS 层抑制该域名的解析结果。
+ *
+ * 诚实回执语义：
+ * - 只有成功把非空域名写入阻断集后，才以 `Activity.RESULT_OK` 回复；
+ * - 域名缺失/非法、或写入失败，一律保持默认 `Activity.RESULT_CANCELED`，
+ *   使 CausalGuard 业务侧据此诚实降级为 `UNAVAILABLE`，绝不谎报已阻断。
+ *
+ * 设计约束（与 A4-3 补丁一致）：
+ * - 不 import 任何 com.causalguard 类型，保持底座自成一体、可回滚；
+ * - 阻断集为进程内静态内存态，随 VPN 服务存活；服务重启后需 CausalGuard 重新下发。
+ */
+public final class CausalGuardDomainBlockReceiver extends BroadcastReceiver {
+
+    /** 与 CausalGuard `TrackerControlBroadcast.ACTION_BLOCK_DOMAIN` 完全一致。 */
+    public static final String ACTION_BLOCK_DOMAIN = "com.causalguard.intent.BLOCK_DOMAIN";
+
+    /** 阻断目标域名（`TrackerControlBroadcast.EXTRA_DOMAIN`）。 */
+    public static final String EXTRA_DOMAIN = "domain";
+
+    private static final String TAG = "TrackerControl.VPN";
+
+    @Override
+    public void onReceive(Context context, Intent intent) {
+        String domain = (intent == null ? null : intent.getStringExtra(EXTRA_DOMAIN));
+        if (domain == null) {
+            Log.w(TAG, "CausalGuard block domain: missing domain, cancel");
+            return;
+        }
+
+        String normalized = domain.trim().toLowerCase(Locale.ROOT);
+        if (normalized.isEmpty()) {
+            Log.w(TAG, "CausalGuard block domain: blank domain, cancel");
+            return;
+        }
+
+        try {
+            ServiceSinkhole.mapCausalGuardBlocked.put(normalized, true);
+            Log.i(TAG, "CausalGuard block domain confirmed: " + normalized);
+            setResultCode(Activity.RESULT_OK);
+        } catch (Throwable ex) {
+            Log.e(TAG, "CausalGuard block domain failed: " + ex);
+        }
+    }
+}
